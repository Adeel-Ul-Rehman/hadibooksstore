# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-your-database-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret (Generate a strong 32+ char secret)
JWT_SECRET=your_jwt_secret_minimum_32_characters_here

# Environment
NODE_ENV=production

# Email Configuration (Resend)
RESEND_API_KEY=your_resend_api_key_here
# SENDER_EMAIL='Hadi Books Store <onboarding@resend.dev>'

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_CALLBACK_URL=https://<your-backend-app>.vercel.app/api/auth/google/callback

# Allowed Origins & Redirects
# FRONTEND_URL=https://<your-client-app>.vercel.app
# ADMIN_URL=https://<your-admin-app>.vercel.app

# Session Secret (Do NOT set COOKIE_DOMAIN on vercel.app domains!)
SESSION_SECRET=your_session_secret_minimum_32_characters_here
